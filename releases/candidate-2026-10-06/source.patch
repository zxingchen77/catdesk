diff --git a/firmware/components/catdesk_ui/catdesk_room.c b/firmware/components/catdesk_ui/catdesk_room.c
new file mode 100644
index 0000000..fb08d4d
--- /dev/null
+++ b/firmware/components/catdesk_ui/catdesk_room.c
@@ -0,0 +1,189 @@
+#include "catdesk_room.h"
+
+#include <stddef.h>
+
+enum {
+    ROOM_LOOP_MS = 300000,
+    WALK_LEG_MS = 5000
+};
+
+static cd_room_pet_pose_t native_pose(const cd_cat_t *cat)
+{
+    cd_room_pet_pose_t pose = {
+        cat->x, cat->y, cat->state, cat->frame, cat->direction,
+        CD_ROOM_ACTIVITY_NONE
+    };
+    return pose;
+}
+
+/* All interpolation distances come from int16 model coordinates or the
+ * fixed room grid, so the multiplication is bounded in a 32-bit int. */
+static int interpolate(int from, int to, uint32_t progress)
+{
+    return from + (to - from) * (int)progress / WALK_LEG_MS;
+}
+
+static int animation_frame(int state, uint32_t elapsed)
+{
+    switch (state) {
+    case CD_CAT_BLINK: return (int)((elapsed / 150u) % 2u);
+    case CD_CAT_WALK: return (int)((elapsed / 120u) % 6u);
+    case CD_CAT_SLEEP: return (int)((elapsed / 500u) % 4u);
+    case CD_CAT_TAP: return (int)((elapsed / 200u) % 6u);
+    default: return (int)((elapsed / 300u) % 4u);
+    }
+}
+
+static cd_room_pet_pose_t activity_target(cd_room_activity_t activity,
+                                          unsigned kind, uint32_t elapsed)
+{
+    cd_room_pet_pose_t target = {0, 170, CD_CAT_IDLE, 0, 1, activity};
+    switch (activity) {
+    case CD_ROOM_ACTIVITY_SOFA:
+        target.x = 77;
+        target.y = 94; /* Sleep silhouette fits the right sofa cushion. */
+        target.state = CD_CAT_SLEEP;
+        target.direction = -1;
+        break;
+    case CD_ROOM_ACTIVITY_BOX:
+        target.x = 56;
+        target.y = 120; /* Head above the opening; front wall masks paws. */
+        target.direction = -1;
+        target.state = elapsed % 6000u < 300u ? CD_CAT_BLINK : CD_CAT_IDLE;
+        break;
+    case CD_ROOM_ACTIVITY_YARN: {
+        /* The existing yarn is x343..350, y216..222. The extended paw
+         * reaches its thread without changing or redrawing the prop. */
+        target.x = 313;
+        target.y = 184;
+        uint32_t play = elapsed % 3000u;
+        target.state = play < 1200u ? CD_CAT_TAP : CD_CAT_IDLE;
+        target.frame = animation_frame(target.state, play);
+        return target;
+    }
+    case CD_ROOM_ACTIVITY_WINDOW:
+        target.x = 54;
+        target.y = 22; /* Paws on y58 sill; weather labels begin at y60. */
+        target.direction = -1;
+        target.state = elapsed % 6000u < 300u ? CD_CAT_BLINK : CD_CAT_IDLE;
+        break;
+    case CD_ROOM_ACTIVITY_MAC:
+        target.x = 268;
+        target.y = 79; /* Paws on desk y115, nose across the Mac display. */
+        target.state = elapsed % 6000u < 300u ? CD_CAT_BLINK : CD_CAT_IDLE;
+        break;
+    case CD_ROOM_ACTIVITY_SNIFF: {
+        uint32_t phase = elapsed % 4000u;
+        int nudge = (int)(phase < 2000u ? phase : 4000u - phase) / 1000;
+        target.x = kind == CD_CAT_ORANGE ? 165 + nudge : 189 - nudge;
+        target.direction = kind == CD_CAT_ORANGE ? 1 : -1;
+        target.state = phase >= 1800u && phase < 2100u
+            ? CD_CAT_BLINK : CD_CAT_IDLE;
+        break;
+    }
+    case CD_ROOM_ACTIVITY_CHASE: {
+        /* Two cats share a bounded eight-second out-and-back lane. On
+         * reversal the trailing cat becomes the leader, with no jump. */
+        uint32_t phase = elapsed % 8000u;
+        uint32_t run = phase < 4000u ? phase : 8000u - phase;
+        int distance = (int)(run * 164u / 4000u);
+        target.x = (kind == CD_CAT_ORANGE ? 128 : 96) + distance;
+        /* Separate the lanes while arriving from native positions, which
+         * may cross after a natural approach. Neither sprite then fully
+         * hides the other during the chase's walk-in or walk-out. */
+        target.y = kind == CD_CAT_ORANGE ? 170 : 178;
+        target.direction = phase < 4000u ? 1 : -1;
+        target.state = CD_CAT_WALK;
+        break;
+    }
+    case CD_ROOM_ACTIVITY_CUDDLE:
+        target.x = kind == CD_CAT_ORANGE ? 166 : 186;
+        target.direction = kind == CD_CAT_ORANGE ? 1 : -1;
+        target.state = CD_CAT_SLEEP;
+        break;
+    default:
+        break;
+    }
+    target.frame = animation_frame(target.state, elapsed);
+    return target;
+}
+
+cd_room_pet_pose_t cd_room_pet_pose(const cd_model_t *model, unsigned kind,
+                                   uint32_t life_ms)
+{
+    if (!model || kind >= CD_CAT_COUNT) {
+        cd_room_pet_pose_t empty = {0, 0, CD_CAT_IDLE, 0, 1,
+                                    CD_ROOM_ACTIVITY_NONE};
+        return empty;
+    }
+    const cd_cat_t *cat = &model->cats[kind];
+    cd_room_pet_pose_t native = native_pose(cat);
+    if (model->celebration_active) return native;
+
+    uint32_t time = life_ms % ROOM_LOOP_MS;
+    cd_room_activity_t activity = CD_ROOM_ACTIVITY_NONE;
+    uint32_t start = 0;
+    uint32_t duration = 30000;
+    if (time >= 30000u && time < 60000u && kind == CD_CAT_ORANGE) {
+        activity = CD_ROOM_ACTIVITY_SOFA;
+        start = 30000;
+    } else if (time >= 60000u && time < 90000u && kind == CD_CAT_BLACK) {
+        activity = CD_ROOM_ACTIVITY_BOX;
+        start = 60000;
+    } else if (time >= 90000u && time < 120000u && kind == CD_CAT_ORANGE) {
+        activity = CD_ROOM_ACTIVITY_YARN;
+        start = 90000;
+    } else if (time >= 120000u && time < 150000u && kind == CD_CAT_BLACK) {
+        activity = CD_ROOM_ACTIVITY_WINDOW;
+        start = 120000;
+    } else if (time >= 150000u && time < 180000u && kind == CD_CAT_ORANGE) {
+        activity = CD_ROOM_ACTIVITY_MAC;
+        start = 150000;
+    } else if (time >= 180000u && time < 210000u) {
+        activity = CD_ROOM_ACTIVITY_SNIFF;
+        start = 180000;
+    } else if (time >= 210000u && time < 250000u) {
+        activity = CD_ROOM_ACTIVITY_CHASE;
+        start = 210000;
+        duration = 40000;
+    } else if (time >= 250000u && time < 290000u) {
+        activity = CD_ROOM_ACTIVITY_CUDDLE;
+        start = 250000;
+        duration = 40000;
+    }
+    if (activity == CD_ROOM_ACTIVITY_NONE) return native;
+
+    uint32_t elapsed = time - start;
+    /* Walk toward a fixed arrival point and leave from a fixed departure
+     * point. Sampling a moving chase/sniff target throughout either walk
+     * would add its motion to the interpolation and cause small jumps. */
+    uint32_t target_elapsed = elapsed;
+    if (elapsed < WALK_LEG_MS) target_elapsed = WALK_LEG_MS;
+    else if (elapsed >= duration - WALK_LEG_MS)
+        target_elapsed = duration - WALK_LEG_MS;
+    cd_room_pet_pose_t target = activity_target(activity, kind, target_elapsed);
+    cd_room_pet_pose_t pose = target;
+    if (elapsed < WALK_LEG_MS) {
+        pose.x = interpolate(native.x, target.x, elapsed);
+        pose.y = interpolate(native.y, target.y, elapsed);
+        pose.direction = target.x >= native.x ? 1 : -1;
+        pose.state = CD_CAT_WALK;
+        pose.frame = animation_frame(CD_CAT_WALK, elapsed);
+    } else if (elapsed >= duration - WALK_LEG_MS) {
+        uint32_t progress = elapsed - (duration - WALK_LEG_MS);
+        pose.x = interpolate(target.x, native.x, progress);
+        pose.y = interpolate(target.y, native.y, progress);
+        pose.direction = native.x >= target.x ? 1 : -1;
+        pose.state = CD_CAT_WALK;
+        pose.frame = animation_frame(CD_CAT_WALK, elapsed);
+    }
+
+    /* Hearts and the black cat's speech bubble remain anchored to the
+     * projected cat. A tap can interrupt any activity without teleporting
+     * back to the rug or replacing its existing reaction animation. */
+    if (cat->state == CD_CAT_TAP || cat->bubble_ms || cat->heart_ms) {
+        pose.state = native.state;
+        pose.frame = native.frame;
+    }
+    return pose;
+}
diff --git a/firmware/components/catdesk_ui/include/catdesk_room.h b/firmware/components/catdesk_ui/include/catdesk_room.h
new file mode 100644
index 0000000..e0eeaf9
--- /dev/null
+++ b/firmware/components/catdesk_ui/include/catdesk_room.h
@@ -0,0 +1,43 @@
+#pragma once
+
+#include "catdesk_model.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef enum {
+    CD_ROOM_ACTIVITY_NONE = 0,
+    CD_ROOM_ACTIVITY_SOFA,
+    CD_ROOM_ACTIVITY_BOX,
+    CD_ROOM_ACTIVITY_YARN,
+    CD_ROOM_ACTIVITY_WINDOW,
+    CD_ROOM_ACTIVITY_MAC,
+    CD_ROOM_ACTIVITY_SNIFF,
+    CD_ROOM_ACTIVITY_CHASE,
+    CD_ROOM_ACTIVITY_CUDDLE
+} cd_room_activity_t;
+
+/* Coordinates are the upper-left of the existing 40 x 40 sprite. Paws are
+ * at y + 36. Only the presentation changes; the simulation stays intact. */
+typedef struct {
+    int x;
+    int y;
+    int state;
+    int frame;
+    int direction;
+    cd_room_activity_t activity;
+} cd_room_pet_pose_t;
+
+/* life_ms is monotonic boot time, independent of the host wall clock. The
+ * choreography repeats every 300000 ms. Celebration uses the exact native
+ * pose; ordinary approaches remain projected during room activities and
+ * use their native pose during NONE slots. Petting uses native state/frame
+ * at projected x/y.
+ * This function neither allocates nor changes the model. */
+cd_room_pet_pose_t cd_room_pet_pose(const cd_model_t *model, unsigned kind,
+                                   uint32_t life_ms);
+
+#ifdef __cplusplus
+}
+#endif
diff --git a/tools/test_room.c b/tools/test_room.c
new file mode 100644
index 0000000..8ed0157
--- /dev/null
+++ b/tools/test_room.c
@@ -0,0 +1,205 @@
+/* Host check: cc -std=c11 -Wall -Wextra -Werror -pedantic \
+ *   -fsanitize=address,undefined -Ifirmware/components/catdesk_ui/include \
+ *   tools/test_room.c firmware/components/catdesk_ui/catdesk_room.c \
+ *   firmware/components/catdesk_ui/catdesk_model.c -o /tmp/catdesk-test-room
+ */
+#include "catdesk_room.h"
+
+#include <assert.h>
+#include <limits.h>
+#include <stdio.h>
+#include <string.h>
+
+static int distance(int a, int b) { return a > b ? a - b : b - a; }
+
+static void assert_native(cd_room_pet_pose_t pose, const cd_cat_t *cat)
+{
+    assert(pose.activity == CD_ROOM_ACTIVITY_NONE);
+    assert(pose.x == cat->x && pose.y == cat->y);
+    assert(pose.state == (int)cat->state && pose.frame == cat->frame);
+    assert(pose.direction == cat->direction);
+}
+
+static void assert_valid(cd_room_pet_pose_t pose)
+{
+    static const int count[] = {4, 2, 6, 4, 6};
+    assert(pose.x >= 40 && pose.x <= 320);
+    assert(pose.y >= 22 && pose.y <= 184);
+    assert(pose.x + 40 <= 400 && pose.y + 40 <= 240);
+    assert(pose.state >= CD_CAT_IDLE && pose.state <= CD_CAT_TAP);
+    assert(pose.frame >= 0 && pose.frame < count[pose.state]);
+    assert(pose.direction == 1 || pose.direction == -1);
+    assert(pose.activity >= CD_ROOM_ACTIVITY_NONE
+           && pose.activity <= CD_ROOM_ACTIVITY_CUDDLE);
+}
+
+static void test_schedule(cd_model_t *model)
+{
+    static const struct {
+        uint32_t time;
+        unsigned kind;
+        cd_room_activity_t activity;
+        int x, y, state;
+    } fixtures[] = {
+        {45000, CD_CAT_ORANGE, CD_ROOM_ACTIVITY_SOFA, 77, 94, CD_CAT_SLEEP},
+        {75000, CD_CAT_BLACK, CD_ROOM_ACTIVITY_BOX, 56, 120, CD_CAT_IDLE},
+        {105000, CD_CAT_ORANGE, CD_ROOM_ACTIVITY_YARN, 313, 184, CD_CAT_TAP},
+        {135000, CD_CAT_BLACK, CD_ROOM_ACTIVITY_WINDOW, 54, 22, CD_CAT_IDLE},
+        {165000, CD_CAT_ORANGE, CD_ROOM_ACTIVITY_MAC, 268, 79, CD_CAT_IDLE},
+        {195000, CD_CAT_ORANGE, CD_ROOM_ACTIVITY_SNIFF, 166, 170, CD_CAT_IDLE},
+        {195000, CD_CAT_BLACK, CD_ROOM_ACTIVITY_SNIFF, 188, 170, CD_CAT_IDLE},
+        {230000, CD_CAT_ORANGE, CD_ROOM_ACTIVITY_CHASE, 292, 170, CD_CAT_WALK},
+        {230000, CD_CAT_BLACK, CD_ROOM_ACTIVITY_CHASE, 260, 178, CD_CAT_WALK},
+        {270000, CD_CAT_ORANGE, CD_ROOM_ACTIVITY_CUDDLE, 166, 170, CD_CAT_SLEEP},
+        {270000, CD_CAT_BLACK, CD_ROOM_ACTIVITY_CUDDLE, 186, 170, CD_CAT_SLEEP}
+    };
+    for (unsigned i = 0; i < sizeof(fixtures) / sizeof(fixtures[0]); ++i) {
+        cd_room_pet_pose_t pose = cd_room_pet_pose(model, fixtures[i].kind,
+                                                 fixtures[i].time);
+        assert(pose.activity == fixtures[i].activity);
+        assert(pose.x == fixtures[i].x && pose.y == fixtures[i].y);
+        assert(pose.state == fixtures[i].state);
+    }
+    for (unsigned kind = 0; kind < CD_CAT_COUNT; ++kind) {
+        assert_native(cd_room_pet_pose(model, kind, 0), &model->cats[kind]);
+        assert_native(cd_room_pet_pose(model, kind, 29999), &model->cats[kind]);
+        assert_native(cd_room_pet_pose(model, kind, 290000), &model->cats[kind]);
+        assert_native(cd_room_pet_pose(model, kind, 299999), &model->cats[kind]);
+    }
+    assert_native(cd_room_pet_pose(model, CD_CAT_BLACK, 45000), &model->cats[1]);
+    assert_native(cd_room_pet_pose(model, CD_CAT_ORANGE, 75000), &model->cats[0]);
+    assert_native(cd_room_pet_pose(model, CD_CAT_BLACK, 105000), &model->cats[1]);
+    assert_native(cd_room_pet_pose(model, CD_CAT_ORANGE, 135000), &model->cats[0]);
+    assert_native(cd_room_pet_pose(model, CD_CAT_BLACK, 165000), &model->cats[1]);
+}
+
+static void test_paths(const cd_model_t *model)
+{
+    /* Every millisecond of the loop, including the chase reversals and
+     * cross-activity boundaries, moves by at most one presentation pixel.
+     * This checks actual continuity rather than only the slot endpoints. */
+    for (unsigned kind = 0; kind < CD_CAT_COUNT; ++kind) {
+        cd_room_pet_pose_t previous = cd_room_pet_pose(model, kind, 0);
+        for (uint32_t time = 1; time <= 300000u; ++time) {
+            cd_room_pet_pose_t pose = cd_room_pet_pose(model, kind, time);
+            assert_valid(pose);
+            if (distance(previous.x, pose.x) > 1 || distance(previous.y, pose.y) > 1)
+                fprintf(stderr, "Cat %u at %u: (%d,%d) -> (%d,%d)\n",
+                        kind, time, previous.x, previous.y, pose.x, pose.y);
+            assert(distance(previous.x, pose.x) <= 1);
+            assert(distance(previous.y, pose.y) <= 1);
+            previous = pose;
+        }
+    }
+}
+
+static void test_priority(cd_model_t *model)
+{
+    for (unsigned kind = 0; kind < CD_CAT_COUNT; ++kind) {
+        uint32_t time = kind == CD_CAT_ORANGE ? 45000u : 135000u;
+        cd_room_pet_pose_t before = cd_room_pet_pose(model, kind, time);
+        cd_model_t copy = *model;
+        cd_model_tap_cat(&copy, (cd_cat_kind_t)kind);
+        cd_room_pet_pose_t tapped = cd_room_pet_pose(&copy, kind, time);
+        assert(tapped.x == before.x && tapped.y == before.y);
+        assert(tapped.activity == before.activity);
+        assert(tapped.state == CD_CAT_TAP && tapped.frame == 0);
+
+        copy.cats[kind].state = CD_CAT_BLINK;
+        copy.cats[kind].frame = 1;
+        copy.cats[kind].bubble_ms = 1800;
+        cd_room_pet_pose_t bubble = cd_room_pet_pose(&copy, kind, time);
+        assert(bubble.x == before.x && bubble.y == before.y);
+        assert(bubble.state == CD_CAT_BLINK && bubble.frame == 1);
+        copy.cats[kind].bubble_ms = 0;
+        copy.cats[kind].heart_ms = 800;
+        cd_room_pet_pose_t heart = cd_room_pet_pose(&copy, kind, time);
+        assert(heart.x == before.x && heart.y == before.y);
+        assert(heart.state == CD_CAT_BLINK && heart.frame == 1);
+
+        copy.celebration_active = true;
+        assert_native(cd_room_pet_pose(&copy, kind, time), &copy.cats[kind]);
+        copy.celebration_active = false;
+        copy.approach_active = true;
+        cd_room_pet_pose_t approach = cd_room_pet_pose(&copy, kind, time);
+        assert(approach.x == before.x && approach.y == before.y);
+        assert(approach.activity == before.activity);
+        assert_native(cd_room_pet_pose(&copy, kind, 10000), &copy.cats[kind]);
+    }
+}
+
+static void test_live_model(void)
+{
+    cd_model_t model;
+    cd_model_init(&model, 1791216000);
+    cd_room_pet_pose_t previous[CD_CAT_COUNT];
+    for (unsigned kind = 0; kind < CD_CAT_COUNT; ++kind)
+        previous[kind] = cd_room_pet_pose(&model, kind, 0);
+    bool was_approaching = false;
+    unsigned approach_starts = 0, approach_ends = 0;
+    unsigned seen_activities = 0;
+    for (uint32_t time = 50; time <= 300000u; time += 50) {
+        cd_model_tick(&model, 50);
+        assert(!model.celebration_active);
+        if (model.approach_active != was_approaching) {
+            if (model.approach_active) ++approach_starts;
+            else ++approach_ends;
+            was_approaching = model.approach_active;
+        }
+        cd_model_t unchanged = model;
+        for (unsigned kind = 0; kind < CD_CAT_COUNT; ++kind) {
+            cd_room_pet_pose_t pose = cd_room_pet_pose(&model, kind, time);
+            assert_valid(pose);
+            seen_activities |= 1u << pose.activity;
+            if (distance(previous[kind].x, pose.x) > 4
+                || distance(previous[kind].y, pose.y) > 4)
+                fprintf(stderr, "Live cat %u at %u: (%d,%d) -> (%d,%d), approach=%d\n",
+                        kind, time, previous[kind].x, previous[kind].y,
+                        pose.x, pose.y, model.approach_active);
+            assert(distance(previous[kind].x, pose.x) <= 4);
+            assert(distance(previous[kind].y, pose.y) <= 4);
+            previous[kind] = pose;
+        }
+        assert(memcmp(&model, &unchanged, sizeof(model)) == 0);
+    }
+    /* The original simulation ran its natural approach repeatedly, while
+     * every furniture/pair slot remained visible and paths stayed smooth. */
+    assert(approach_starts >= 4 && approach_ends >= 4);
+    assert(seen_activities == (1u << (CD_ROOM_ACTIVITY_CUDDLE + 1u)) - 1u);
+}
+
+static void test_pure_and_long_time(cd_model_t *model)
+{
+    cd_model_t original = *model;
+    const uint32_t times[] = {300000, 600000, UINT32_MAX, UINT32_MAX - 1u,
+                              1000000000u, 4294800000u};
+    for (unsigned i = 0; i < sizeof(times) / sizeof(times[0]); ++i) {
+        for (unsigned kind = 0; kind < CD_CAT_COUNT; ++kind) {
+            cd_room_pet_pose_t actual = cd_room_pet_pose(model, kind, times[i]);
+            cd_room_pet_pose_t wrapped = cd_room_pet_pose(model, kind,
+                                                         times[i] % 300000u);
+            assert(actual.x == wrapped.x && actual.y == wrapped.y);
+            assert(actual.state == wrapped.state && actual.frame == wrapped.frame);
+            assert(actual.direction == wrapped.direction);
+            assert(actual.activity == wrapped.activity);
+            assert_valid(actual);
+        }
+    }
+    assert(memcmp(model, &original, sizeof(original)) == 0);
+    assert(cd_room_pet_pose(NULL, 0, UINT32_MAX).activity == CD_ROOM_ACTIVITY_NONE);
+    assert(cd_room_pet_pose(model, CD_CAT_COUNT, UINT32_MAX).activity == CD_ROOM_ACTIVITY_NONE);
+}
+
+int main(void)
+{
+    cd_model_t model;
+    cd_model_init(&model, 1791216000); /* October 6; anniversary not running. */
+    assert(!model.celebration_active && !model.approach_active);
+    test_schedule(&model);
+    test_paths(&model);
+    test_priority(&model);
+    test_live_model();
+    test_pure_and_long_time(&model);
+    puts("CatDesk room: paths, bounds, reactions, celebration and pure wrapping passed.");
+    return 0;
+}
